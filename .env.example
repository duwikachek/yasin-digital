# ─────────────────────────────────────────────────────────────
# Hosting gambar untuk upload foto di Panel Admin (pilih SALAH SATU)
# ─────────────────────────────────────────────────────────────

# Opsi A — Cloudinary (unsigned upload preset)
# Buat akun gratis di https://cloudinary.com lalu:
# 1. Catat "Cloud name" di dashboard.
# 2. Settings > Upload > Upload presets > Add upload preset > Signing mode: Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opsi B — imgbb (lebih sederhana, cukup 1 API key)
# Ambil API key gratis di https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# Catatan: jika keduanya diisi, Cloudinary dipakai lebih dulu.
# Jika tidak ada yang diisi, foto otomatis disimpan lokal sebagai base64.
